NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=
MONGODB_DB=senganthal
# Email OTP delivery requires a verified sending domain in Resend.
RESEND_API_KEY=
EMAIL_OTP_FROM=Senganthal <login@senganthal.co.in>
# Set true for local demos when Atlas is blocked by network/IP access.
MONGODB_LOCAL_FALLBACK=false
# These verified Google accounts bootstrap owners; comma-separated. Never sent to browser.
ADMIN_EMAILS=
# Billing stays closed until configured. Never use test payments on the live domain.
RAZORPAY_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_YEARLY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# For a separate HTTPS staging site only; localhost is automatically allowed.
BILLING_TEST_ORIGIN=
# Optional expiring reviewer identity. Generate privately with node scripts/create-reviewer.mjs.
REVIEWER_LOGIN_ENABLED=false
REVIEWER_LOGIN_EMAIL=
REVIEWER_PASSWORD_HASH=
REVIEWER_ACCESS_EXPIRES_AT=
# Optional PDF extraction. Uploads are sent only after explicit confirmation in the app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
