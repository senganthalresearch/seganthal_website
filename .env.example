NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=
MONGODB_DB=senganthal
# Set true for local demos when Atlas is blocked by network/IP access.
MONGODB_LOCAL_FALLBACK=false
# These verified Google accounts bootstrap owners; comma-separated. Never sent to browser.
ADMIN_EMAILS=
# Razorpay Subscriptions: create an INR 600 yearly plan in Test Mode first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# 2Factor SMS OTP for Indian mobile registration and password reset.
TWOFACTOR_API_KEY=
# Optional approved SMS template name from the 2Factor dashboard.
TWOFACTOR_TEMPLATE_NAME=
# Optional PDF extraction. Uploads are sent only after explicit confirmation in the app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
